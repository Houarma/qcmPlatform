# Groq API
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin SDK (Spring Boot) — encode ton serviceAccount.json en base64
FIREBASE_SERVICE_ACCOUNT_B64=your_base64_encoded_service_account

# Firebase Web SDK (Next.js)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.europe-west1.firebasedatabase.app

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/qcmdb
SPRING_DATASOURCE_USERNAME=qcmuser
SPRING_DATASOURCE_PASSWORD=qcmpassword
FIREBASE_PROJECT_ID=your_project_id
ML_SERVICE_URL=http://ml-service:8000
